# frozen_string_literal: true

# Build/release tasks for the blusher gem. In the rubyrs monorepo the `compile`
# tasks build the sibling crates from the cargo workspace and stage the loadable
# object; in the standalone momiji-rs/blusher repo, `gem install` compiles
# ext/blusher via rb-sys/extconf.rb and CI cross-compiles via cross-gem-action,
# so the rake `compile` here is a dev convenience only.

# `gem build` / `release` (the standalone publish path also goes through the
# Trusted-Publishing workflow, not `rake release`).
require "bundler/gem_tasks" if File.exist?(File.expand_path("Gemfile", __dir__))

REPO       = File.expand_path("..", __dir__)              # rubyrs workspace root (dev)
DLEXT      = (RbConfig::CONFIG["host_os"] =~ /darwin/ ? "dylib" : "so")
RBDLEXT    = RbConfig::CONFIG["DLEXT"]                     # ruby loadable suffix (bundle/so)
CDYLIB     = "libcarmine_ffi.#{DLEXT}"
EXT_DIR    = File.expand_path("ext", __dir__)
LIB_DIR    = File.expand_path("lib", __dir__)
TABLES_DIR = File.expand_path("lib/blusher/tables", __dir__)
EXTRACT    = File.join(REPO, "crates/carmine/tools/extract.rb")

desc "Build the magnus native extension and stage it as lib/blusher.<dlext>"
task :compile do
  sh "cargo build --release -p blusher-ext", chdir: REPO
  # cargo emits libblusher.dylib/.so; `require` needs the ruby ext suffix.
  cp File.join(REPO, "target/release", "libblusher.#{DLEXT}"),
     File.join(LIB_DIR, "blusher.#{RBDLEXT}")
end

desc "Build the carmine-ffi cdylib fallback and stage it under ext/"
task :compile_ffi do
  sh "cargo build --release -p carmine-ffi", chdir: REPO
  mkdir_p EXT_DIR
  cp File.join(REPO, "target/release", CDYLIB), File.join(EXT_DIR, CDYLIB)
end

desc "Generate the per-lexer carmine tables (lib/blusher/tables/<tag>.json)"
task :tables do
  require "rouge"
  mkdir_p TABLES_DIR
  Rouge::Lexer.all.each do |lx|
    next unless lx.respond_to?(:state_definitions)
    tag = lx.tag rescue next
    cls = lx.name.split("::").last
    json = `ruby --parser=parse.y #{EXTRACT} #{cls} 2>/dev/null`
    File.write(File.join(TABLES_DIR, "#{tag}.json"), json) unless json.strip.empty?
  end
  puts "wrote #{Dir[File.join(TABLES_DIR, '*.json')].size} tables"
end

desc "Run rouge's lexer spec suite through blusher (the correctness gate)"
task :spec do
  rouge_src = ENV["ROUGE_SRC"] or abort "set ROUGE_SRC=<rouge checkout>"
  sh({ "RUBYLIB" => "#{__dir__}/lib" },
     "cd #{rouge_src} && bundle exec ruby -Ilib -Ispec " \
     "-e 'require \"spec_helper\"; require \"blusher\"; " \
     "Dir[\"./spec/lexers/*_spec.rb\"].sort.each { |f| require f }'")
end

task default: %i[compile tables]
