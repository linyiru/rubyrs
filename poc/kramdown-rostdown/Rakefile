# frozen_string_literal: true

EXT_DIR = File.expand_path("ext", __dir__)

desc "Build the rostdown cdylib (release)"
task :compile do
  Dir.chdir(EXT_DIR) { sh "cargo build --release" }
end

desc "Differential conformance: accelerated vs pure kramdown over both corpora"
task spec: :compile do
  sh "ruby bin/spec_diff.rb"
end

desc "Benchmark accelerated vs pure kramdown"
task bench: :compile do
  sh "ruby bin/bench.rb"
end

task default: %i[compile spec]
